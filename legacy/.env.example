# Jarvis — configuration
# Copie ce fichier en .env et adapte les valeurs

# URL de l'API Ollama (compatible OpenAI)
# Localhost par défaut ; IP Tailscale possible via variable d'env
OLLAMA_URL=http://localhost:11434/v1/chat/completions

# Modèles
MODEL=gemma4:e4b
MODEL_FAST=gemma4:e2b

# Port du serveur Bun
PORT=3000

# Chemin vers edge-tts (optionnel, sinon 'edge-tts' dans PATH)
# EDGE_TTS_BIN=/chemin/vers/edge-tts

# Voix TTS edge-tts
TTS_VOICE=fr-FR-DeniseNeural
TTS_RATE=+5%
REASONING_EFFORT=none
NUM_CTX=16384
