<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>fr_FR</string>
    <key>CFBundleExecutable</key>
    <string>JarvisLocal</string>
    <key>CFBundleIdentifier</key>
    <string>com.dimitriclaverie.JarvisLocal</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>JarvisLocal</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.9.3</string>
    <key>CFBundleVersion</key>
    <string>0.9.3</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Jarvis a besoin du microphone pour la reconnaissance vocale.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Jarvis a besoin de la reconnaissance vocale pour le mode conversationnel.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>Jarvis a besoin d'accéder au calendrier pour créer des événements.</string>
    <key>NSRemindersUsageDescription</key>
    <string>Jarvis a besoin d'accéder aux rappels pour en créer.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Jarvis a besoin de contrôler d'autres applications via AppleScript.</string>
    <key>NSContactsUsageDescription</key>
    <string>Jarvis a besoin d'accéder à vos contacts pour envoyer des messages.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Jarvis utilise votre position approximative pour la météo (WeatherKit) et la recherche de lieux (MapKit).</string>
    <key>NSScreenCaptureDescription</key>
    <string>Jarvis a besoin de capture d'écran pour prendre des screenshots.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Pas de NSAllowsArbitraryLoads, pas d'IP ni de nom en dur : le HTTP
             en clair est autorisé par l'OS vers le local (NSAllowsLocalNetworking)
             et vers *.ts.net (noms MagicDNS Tailscale, quel que soit le tailnet).
             La restriction AU SEUL hôte configuré est applicative
             (OllamaHostPolicy : localhost / 100.64.0.0/10 / *.ts.net, sinon
             HTTPS exigé) — et Tailscale ne route de toute façon que son propre
             tailnet. En pratique : renseigner le NOM MagicDNS du serveur dans
             les réglages (pas son IP). Tout le reste (DDG, Open-Meteo, GitHub)
             reste en HTTPS forcé. -->
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>ts.net</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSTemporaryExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>
    <!-- App omniprésente : pas de Dock, vit dans la menu bar + HUD. Elle ne
         quitte JAMAIS à la fermeture d'une fenêtre. -->
    <key>LSUIElement</key>
    <true/>
</dict>
</plist>
