<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime : pas d'exception (pas de JIT, pas de dylibs non signées).
         Tous les droits ci-dessous correspondent aux Info.plist usage descriptions. -->
    <key>com.apple.security.device.microphone</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Contrôle d'autres apps via Apple Events (Messages, Notes, System Events…).
         `true` en dev ; resserrer en release vers les bundle IDs ciblés avec
         com.apple.security.automation.apple-events + dict par cible. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
