<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime : pas d'exception (pas de JIT, pas de dylibs non signées).
         Tous les droits ci-dessous correspondent aux Info.plist usage descriptions. -->
    <key>com.apple.security.device.microphone</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Contrôle d'autres apps via Apple Events (Messages, Notes, System Events…).
         App non-sandboxée (hardened runtime) : la valeur `true` est la forme
         correcte — le scoping fin par bundleID (dict) ne s'applique qu'avec
         App Sandbox + `com.apple.security.scripting-targets`. La restriction
         réelle est donc : templates AppleScript figés (AppleScriptRunner),
         confirmation utilisateur obligatoire (sensitiveTools), TCC par cible.
         Cibles utilisées : com.apple.Notes, com.apple.MobileSMS, com.apple.systemevents. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
